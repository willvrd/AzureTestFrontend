---
// src/components/blog/PostList.astro
import FormattedDate from "../FormattedDate.astro";

const API_URL = import.meta.env.PUBLIC_API_URL + "/posts";

interface Post {
    id: number;
    title: string;
    content?: string;
    imageFullUrl?: string;
    createdAt: string;
}

let posts: Post[] = [];
let errorMessage = null;

try {
    //Create Abort Controller
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 4000); // 4 segundos max

    const response = await fetch(API_URL, {
        signal: controller.signal,
    });

    clearTimeout(timeoutId);

    if (!response.ok) {
        throw new Error(`API ERROR: ${response.status} ${response.statusText}`);
    }

    const jsonResponse = await response.json();
    posts = jsonResponse.data || [];
} catch (error: any) {
    console.error("Error loading posts on Azure:", error);

    //
    if (error.name === "AbortError") {
        errorMessage = `Connection Timeout: The API at: ${API_URL}  ... took too long to respond.`;
    } else {
        errorMessage = `Backend Error: ${error.message} (Target URL: ${API_URL})`;
    }
}
---

{
    errorMessage && (
        <div class="error-box">
            <p>
                <strong>⚠️ Frontend Alert:</strong> {errorMessage}
            </p>
        </div>
    )
}

<ul>
    {
        posts.map((post) => (
            <li>
                <a href={`/blog/${post.id}/`}>
                    {post.imageFullUrl && (
                        <img
                            width={720}
                            height={360}
                            src={post.imageFullUrl}
                            alt={post.title}
                        />
                    )}
                    <h4 class="title">{post.title}</h4>
                    <p class="date">
                        <FormattedDate date={new Date(post.createdAt)} />
                    </p>
                </a>
            </li>
        ))
    }
</ul>
