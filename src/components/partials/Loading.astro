---
// src/components/partials/Loading.astro

interface Props {
    message?: string;
}

// Set the default message in English if none is provided via props
const { message = "Loading content..." } = Astro.props;
---

<div class="loading-container">
    <div class="spinner"></div>
    <p class="loading-text">{message}</p>
</div>

<style>
    /* Scoped styles to guarantee reusability anywhere */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
        gap: 1rem;
        width: 100%;
    }

    .spinner {
        width: 44px;
        height: 44px;
        border: 4px solid rgb(var(--gray-light));
        border-bottom-color: rgb(var(--accent));
        border-radius: 50%;
        animation: rotation 0.8s linear infinite;
    }

    .loading-text {
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.05em;
    }

    @keyframes rotation {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
</style>
