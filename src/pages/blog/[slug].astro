---
// src/pages/blog/[slug].astro
export const prerender = false;

import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PostShow from "../../components/blog/PostShow/PostShow.astro";

const { slug } = Astro.params;
const BASE_API_URL = import.meta.env.API_URL + "/blog/posts";
const API_URL = `${BASE_API_URL}/${slug}`;

let post = null;
let errorMessage = null;

try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 25000);

    const response = await fetch(API_URL, { signal: controller.signal });
    clearTimeout(timeoutId);

    if (response.status == 404) return Astro.redirect("/404");
    if (!response.ok) throw new Error(`API ERROR: ${response.status}`);

    const jsonResponse = await response.json();
    post = jsonResponse.data || null;

    if (!post) return Astro.redirect("/404");
} catch (error: any) {
    console.error("Error loading single post on Azure:", error);
    errorMessage =
        error.name === "AbortError"
            ? "Connection Timeout: The API took too long to respond."
            : `Backend Error: ${error.message}`;
}
---

<!doctype html>
<html lang="en">
    <head>
        {
            post && (
                <BaseHead
                    title={post.title}
                    description={post.content?.substring(0, 150) || ""}
                />
            )
        }
    </head>
    <body>
        <Header />
        <main>
            {
                errorMessage && (
                    <div class="error-box">
                        <p>
                            <strong>⚠️ Frontend Alert:</strong> {errorMessage}
                        </p>
                    </div>
                )
            }

            {post && <PostShow post={post} />}
        </main>
        <Footer />
    </body>
</html>

<style>
    main {
        width: calc(100% - 2rem);
        max-width: 100%;
        margin: 0 auto;
        padding: 2rem 1rem;
    }
    .error-box {
        background: #ff555522;
        border: 1px solid #ff5555;
        color: #ff5555;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        max-width: 720px;
        margin: 0 auto;
    }
</style>
