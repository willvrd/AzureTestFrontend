---
// src/pages/blog/index.astro
export const prerender = false;

import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Loading from "../../components/partials/Loading.astro";
import PostList from "../../components/blog/PostList/PostList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h2 style="text-align: center;">Data from API</h2>
			<section>
				<PostList server:defer>
					<Loading slot="fallback" message="Loading content..." />
				</PostList>
			</section>
		</main>
		<Footer />
	</body>
</html>
